PORT=3000
GO_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Origin,Content-Type,Accept,Authorization
CORS_MAX_AGE=86400
RATE_LIMIT_MAX=100

###> postgres ###
POSTGRES_VERSION=16
POSTGRES_DB=db
POSTGRES_USER=random
POSTGRES_PASSWORD=random
POSTGRES_NAME=database
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_NAME}:5432/${POSTGRES_DB}?sslmode=disable
###< postgres ###

###> ngrok/ngrok ###
NGROK_AUTHTOKEN=
###< ngrok/ngrok ###

###> clerk/clerk-go ###
CLERK_WEBHOOK_SECRET=
CLERK_SECRET_KEY=
CLERK_FRONTEND_API=
###< clerk/clerk-go ###

###> rabbitmq ###
RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=password
RABBITMQ_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@rabbitmq:5672/
RABBITMQ_EXCHANGE=domain.events
RABBITMQ_QUEUE=domain.events
RABBITMQ_ROUTING_KEY=user.#,media.*.v1,scan.#,media.analyze.metadata.done.v1,media.analyze.heuristics.done.v1,media.analyze.ai_model.done.v1
RABBITMQ_RETRY_TTL_MS=30000
WORKER_MAX_RETRIES=3
OUTBOX_POLL_INTERVAL=2s
WORKER_CONCURRENCY=4
METADATA_ANALYZE_QUEUE=metadata.analyze
METADATA_ANALYZE_ROUTING_KEY=media.analyze.metadata.v1
HEURISTICS_ANALYZE_QUEUE=heuristics.analyze
HEURISTICS_ANALYZE_ROUTING_KEY=media.analyze.heuristics.v1
AI_MODEL_ANALYZE_QUEUE=ai_model.analyze
AI_MODEL_ANALYZE_ROUTING_KEY=media.analyze.ai_model.v1
###< rabbitmq ###

###> sightengine ###
SIGHTENGINE_API_URL=https://api.sightengine.com/1.0/check.json
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
###< sightengine ###

###> s3 ###
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_INTERNAL_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_THUMBNAIL_BUCKET=thumbnails
STORAGE_USE_PATH_STYLE=true
MINIO_WEBHOOK_SECRET=
###< s3 ###

###> centrifugo/centrifugo ###
CENTRIFUGO_URL=http://centrifugo:8000/api
CENTRIFUGO_API_KEY=dev-centrifugo-api-key
CENTRIFUGO_TOKEN_SECRET=dev-centrifugo-token-secret
CENTRIFUGO_ALLOWED_ORIGINS=http://localhost:3000 http://localhost:3001
CENTRIFUGO_PUBLIC_WS_URL=ws://localhost:8000/connection/websocket
###< centrifugo/centrifugo ###

###> stripe/stripe ###
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
REDIRECT_SUCCESS_URL=http://localhost:3001/subscription/success
REDIRECT_CANCEL_URL=http://localhost:3001/subscription/failed
REDIRECT_PORTAL_URL=http://localhost:3001/subscription
###< stripe/stripe ###
